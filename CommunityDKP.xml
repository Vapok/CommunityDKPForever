		</Size>
		<NormalFont style="GameFontHighlight"/>
		<HighlightFont style="GameFontHighlight"/>
		<DisabledFont style="GameFontDisable"/>
	</Button>
	
	<Button name="CommDKPTabButtonTemplate" motionScriptsWhileDisabled="true" virtual="true">
        <Size>
            <AbsDimension x="10" y="32"/>
        </Size>
        <Layers>
        	<Layer level="BACKGROUND">
        		<Texture name="$parentLeftDisabled" parentKey="LeftActive" file="Interface\AddOns\CommunityDKPForever\Media\Textures\CommDKP-Active-Tab">
        			<Size>
        				<AbsDimension x="20" y="35"/>
        			</Size>
        			<Anchors>
        				<Anchor point="TOPLEFT">
        					<Offset>
        						<AbsDimension x="0" y="0"/>
        					</Offset>
        				</Anchor>
        			</Anchors>
					<TexCoords left="0" right="0.15625" top="0" bottom="0.546875"/>
        		</Texture>
				<Texture name="$parentMiddleDisabled" parentKey="MiddleActive" file="Interface\AddOns\CommunityDKPForever\Media\Textures\CommDKP-Active-Tab">
        			<Size>
        				<AbsDimension x="88" y="35"/>
        			</Size>
        			<Anchors>
        				<Anchor point="LEFT" relativeTo="$parentLeftDisabled" relativePoint="RIGHT"/>
        			</Anchors>
					<TexCoords left="0.15625" right="0.84375" top="0" bottom="0.546875"/>
        		</Texture>
				<Texture name="$parentRightDisabled" parentKey="RightActive" file="Interface\AddOns\CommunityDKPForever\Media\Textures\CommDKP-Active-Tab">
        			<Size>
        				<AbsDimension x="20" y="35"/>
        			</Size>
        			<Anchors>
        				<Anchor point="LEFT" relativeTo="$parentMiddleDisabled" relativePoint="RIGHT"/>
        			</Anchors>
					<TexCoords left="0.84375" right="1.0" top="0" bottom="0.546875"/>
        		</Texture>
				<Texture name="$parentLeft" parentKey="Left" file="Interface\AddOns\CommunityDKPForever\Media\Textures\CommDKP-Inactive-Tab">
        			<Size>
        				<AbsDimension x="20" y="47"/>
        			</Size>
        			<Anchors>
        				<Anchor point="TOPLEFT" x="0" y="-1"/>
        			</Anchors>
					<TexCoords left="0" right="0.15625" top="0" bottom="1.0"/>
        		</Texture>
				<Texture name="$parentMiddle" parentKey="Middle" file="Interface\AddOns\CommunityDKPForever\Media\Textures\CommDKP-Inactive-Tab">
        			<Size>
        				<AbsDimension x="88" y="47"/>
        			</Size>
        			<Anchors>
        				<Anchor point="LEFT" relativeTo="$parentLeft" relativePoint="RIGHT"/>
					</Anchors>
					<TexCoords left="0.15625" right="0.84375" top="0" bottom="1.0"/>
        		</Texture>
				<Texture name="$parentRight" parentKey="Right" file="Interface\AddOns\CommunityDKPForever\Media\Textures\CommDKP-Inactive-Tab">
        			<Size>
        				<AbsDimension x="20" y="47"/>
        			</Size>
        			<Anchors>
        				<Anchor point="LEFT" relativeTo="$parentMiddle" relativePoint="RIGHT"/>
        			</Anchors>
					<TexCoords left="0.84375" right="1.0" top="0" bottom="1.0"/>
        		</Texture>
        	</Layer>
        </Layers>
		<!-- CDKP-006 F6-b (AD-8.3): scripts are set up in Lua (ConfigMenuTabs.lua SetTabs); no Blizzard tab-template helpers are called. -->
		<ButtonText name="$parentText" parentKey="Text">
			<Size>
				<AbsDimension x="0" y="10"/>
			</Size>
			<Anchors>
				<Anchor point="CENTER">
					<Offset>
						<AbsDimension x="0" y="2"/>
					</Offset>
				</Anchor>
			</Anchors>
		</ButtonText>
		<NormalFont style="CommDKPSmallOutlineCenter"/>
		<HighlightFont style="CommDKPSmallOutlineCenter"/>
		<DisabledFont style="CommDKPSmallOutlineCenter"/>
		<HighlightTexture name="$parentHighlightTexture" parentKey="HighlightTexture" file="Interface\PaperDollInfoFrame\UI-Character-Tab-RealHighlight" alphaMode="ADD">
			<Anchors>
				<Anchor point="TOPLEFT">
					<Offset>
						<AbsDimension x="3" y="5"/>
					</Offset>
				</Anchor>
				<Anchor point="BOTTOMRIGHT">
					<Offset>
						<AbsDimension x="-3" y="0"/>
					</Offset>
				</Anchor>
			</Anchors>
		</HighlightTexture>
    </Button>
    <!-- CDKP-005 (AD-5.4): BackdropTemplate replaces the legacy XML backdrop node (unsupported since 9.0);
         the backdrop itself is applied in Lua via CommDKP:ApplyBackdrop(slider, "Slider"). -->
    <Slider name="CommDKPSliderTemplate" inherits="BackdropTemplate" orientation="HORIZONTAL" enableMouse="true" virtual="true">
		<HitRectInsets>
			<AbsInset left="0" right="0" top="-10" bottom="-10"/>
		</HitRectInsets>
		<ThumbTexture parentKey="Thumb" name="$parentThumb" file="Interface\AddOns\CommunityDKPForever\Media\Textures\slider-pin">
			<Size x="16" y="16"/>
		</ThumbTexture>
	</Slider>
	<Slider name="CommDKPOptionsSliderTemplate" inherits="CommDKPSliderTemplate" virtual="true">
		<KeyValues>
			<KeyValue key="type" value="CONTROLTYPE_SLIDER" type="global"/>
		</KeyValues>
		<Size x="144" y="10"/>
		<Layers>
			<Layer level="ARTWORK">
				<FontString name="$parentText" parentKey="Text" inherits="GameFontHighlight">
					<Anchors>
						<Anchor point="BOTTOM" relativePoint="TOP"/>
					</Anchors>
				</FontString>
				<FontString name="$parentLow" parentKey="Low" inherits="GameFontHighlightSmall" text="LOW">
					<Anchors>
						<Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT">
							<Offset>
								<AbsDimension x="-4" y="-4"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<FontString name="$parentHigh" parentKey="High" inherits="GameFontHighlightSmall" text="HIGH">
					<Anchors>
						<Anchor point="TOPRIGHT" relativePoint="BOTTOMRIGHT">
							<Offset>
								<AbsDimension x="4" y="-4"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnEnter>
				if ( self:IsEnabled() ) then
					if ( self.tooltipText ) then
						GameTooltip:SetOwner(self, self.tooltipOwnerPoint or "ANCHOR_RIGHT");
						GameTooltip:SetText(self.tooltipText, 0.25, 0.75, 0.90, 1, true);
					end
					if ( self.tooltipRequirement ) then
						GameTooltip:AddLine(self.tooltipRequirement, 1.0, 1.0, 1.0, true);
						GameTooltip:Show();
					end
					if ( self.tooltipWarning ) then
						GameTooltip:AddLine(self.tooltipWarning, 1, 0, 0, 1, true);
						GameTooltip:Show();
					end
				end
			</OnEnter>
			<OnLeave>
				GameTooltip:Hide();
			</OnLeave>
		</Scripts>
	</Slider>
</Ui>


