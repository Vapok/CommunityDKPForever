<Ui xmlns="http://www.blizzard.com/wow/ui/"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
 	<!-- Custom Highlight Template -->
 	<Texture name="CommunityDKPButtonHighlightTexture" file="Interface\AddOns\CommunityDKPForever\Media\Textures\CommunityDKP-Button-Highlight" alphaMode="ADD" virtual="true">
		<TexCoords left="0" right="0.625" top="0" bottom="0.6875"/>
	</Texture>
	<!-- CDKP-009d (AD-16.5 (a)): the legacy CommDKPTiny/Small/Normal/Large font objects and the bundled
	     homizio_bold.ttf / uf_font.ttf faces are retired; every FontString uses the W.FONT (GameFont*) ramp. -->
 	<!-- Button Frame Template -->
 	<Button name="CommunityDKPUIPanelButtonNoTooltipTemplate" virtual="true">
		<Size x="40" y="22"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Left" file="Interface\Buttons\UI-Panel-Button-Disabled-Down">
					<Size x="12" y="22"/>
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="BOTTOMLEFT"/>
					</Anchors>
					<TexCoords left="0" right="0.09375" top="0" bottom="0.6875"/>
				</Texture>
				<Texture parentKey="Right" file="Interface\Buttons\UI-Panel-Button-Disabled-Down">
					<Size x="12" y="22"/>
					<Anchors>
						<Anchor point="TOPRIGHT"/>
						<Anchor point="BOTTOMRIGHT"/>
					</Anchors>
					<TexCoords left="0.53125" right="0.625" top="0" bottom="0.6875"/>
				</Texture>
				<Texture parentKey="Middle" file="Interface\Buttons\UI-Panel-Button-Disabled-Down">
					<Size x="12" y="22"/>
					<Anchors>
						<Anchor point="TOPLEFT" relativeKey="$parent.Left" relativePoint="TOPRIGHT"/>
						<Anchor point="BOTTOMRIGHT" relativeKey="$parent.Right" relativePoint="BOTTOMLEFT"/>
					</Anchors>
					<TexCoords left="0.09375" right="0.53125" top="0" bottom="0.6875"/>
				</Texture>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad function="CommunityDKPButton_OnLoad"/>
			<OnMouseDown function="CommunityDKPButton_OnMouseDown"/>
			<OnMouseUp function="CommunityDKPButton_OnMouseUp"/>
			<OnShow function="CommunityDKPButton_OnShow"/>
			<OnDisable function="CommunityDKPButton_OnDisable"/>
			<OnEnable function="CommunityDKPButton_OnEnable"/>
		</Scripts>
		<ButtonText name="$parentText" parentKey="Text"/>
		<NormalFont style="GameFontNormal"/>
		<HighlightFont style="GameFontHighlight"/>
		<DisabledFont style="GameFontDisable"/>
		<HighlightTexture inherits="CommunityDKPButtonHighlightTexture"/>
	</Button>
	<Button name="CommunityDKPButtonTemplate" inherits="CommunityDKPUIPanelButtonNoTooltipTemplate" virtual="true">
		<Size>
			<AbsDimension x="144" y="21"/>
		</Size>
		<NormalFont style="GameFontHighlight"/>
		<HighlightFont style="GameFontHighlight"/>
		<DisabledFont style="GameFontDisable"/>
	</Button>
	
	<!-- CDKP-009c: the unused CommDKPTabButtonTemplate (legacy bottom tabs, superseded by side-tabs in §11.1.4) is retired. -->
    <!-- CDKP-005 (AD-5.4): BackdropTemplate replaces the legacy XML backdrop node (unsupported since 9.0);
         CDKP-009: the bar itself is painted in Lua by W.StyleSlider (Modules/UI/Widgets.lua). -->
    <Slider name="CommDKPSliderTemplate" inherits="BackdropTemplate" orientation="HORIZONTAL" enableMouse="true" virtual="true">
		<HitRectInsets>
			<AbsInset left="0" right="0" top="-10" bottom="-10"/>
		</HitRectInsets>
		<ThumbTexture parentKey="Thumb" name="$parentThumb" file="Interface\AddOns\CommunityDKPForever\Media\Textures\slider-pin">
			<Size x="16" y="16"/>
		</ThumbTexture>
	</Slider>
	<Slider name="CommDKPOptionsSliderTemplate" inherits="CommDKPSliderTemplate" virtual="true">
		<KeyValues>
			<KeyValue key="type" value="CONTROLTYPE_SLIDER" type="global"/>
		</KeyValues>
		<Size x="144" y="10"/>
		<Layers>
			<Layer level="ARTWORK">
				<FontString name="$parentText" parentKey="Text" inherits="GameFontHighlight">
					<Anchors>
						<Anchor point="BOTTOM" relativePoint="TOP"/>
					</Anchors>
				</FontString>
				<FontString name="$parentLow" parentKey="Low" inherits="GameFontHighlightSmall" text="LOW">
					<Anchors>
						<Anchor point="TOPLEFT" relativePoint="BOTTOMLEFT">
							<Offset>
								<AbsDimension x="-4" y="-4"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<FontString name="$parentHigh" parentKey="High" inherits="GameFontHighlightSmall" text="HIGH">
					<Anchors>
						<Anchor point="TOPRIGHT" relativePoint="BOTTOMRIGHT">
							<Offset>
								<AbsDimension x="4" y="-4"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnEnter>
				if ( self:IsEnabled() ) then
					if ( self.tooltipText ) then
						GameTooltip:SetOwner(self, self.tooltipOwnerPoint or "ANCHOR_RIGHT");
						GameTooltip:SetText(self.tooltipText, 0.25, 0.75, 0.90, 1, true);
					end
					if ( self.tooltipRequirement ) then
						GameTooltip:AddLine(self.tooltipRequirement, 1.0, 1.0, 1.0, true);
						GameTooltip:Show();
					end
					if ( self.tooltipWarning ) then
						GameTooltip:AddLine(self.tooltipWarning, 1, 0, 0, 1, true);
						GameTooltip:Show();
					end
				end
			</OnEnter>
			<OnLeave>
				GameTooltip:Hide();
			</OnLeave>
		</Scripts>
	</Slider>
</Ui>


