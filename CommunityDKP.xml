 	<!-- Button Frame Template -->
 	<Button name="CommunityDKPUIPanelButtonNoTooltipTemplate" virtual="true">
		<Size x="40" y="22"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Left" file="Interface\Buttons\UI-Panel-Button-Disabled-Down">
					<Size x="12" y="22"/>
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="BOTTOMLEFT"/>
					</Anchors>
					<TexCoords left="0" right="0.09375" top="0" bottom="0.6875"/>
				</Texture>
				<Texture parentKey="Right" file="Interface\Buttons\UI-Panel-Button-Disabled-Down">
					<Size x="12" y="22"/>
					<Anchors>
						<Anchor point="TOPRIGHT"/>
						<Anchor point="BOTTOMRIGHT"/>
					</Anchors>
					<TexCoords left="0.53125" right="0.625" top="0" bottom="0.6875"/>
				</Texture>
				<Texture parentKey="Middle" file="Interface\Buttons\UI-Panel-Button-Disabled-Down">
					<Size x="12" y="22"/>
					<Anchors>
						<Anchor point="TOPLEFT" relativeKey="$parent.Left" relativePoint="TOPRIGHT"/>
						<Anchor point="BOTTOMRIGHT" relativeKey="$parent.Right" relativePoint="BOTTOMLEFT"/>
					</Anchors>
					<TexCoords left="0.09375" right="0.53125" top="0" bottom="0.6875"/>
				</Texture>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad function="CommunityDKPButton_OnLoad"/>
			<OnMouseDown function="CommunityDKPButton_OnMouseDown"/>
			<OnMouseUp function="CommunityDKPButton_OnMouseUp"/>
			<OnShow function="CommunityDKPButton_OnShow"/>
			<OnDisable function="CommunityDKPButton_OnDisable"/>
			<OnEnable function="CommunityDKPButton_OnEnable"/>
		</Scripts>
		<ButtonText name="$parentText" parentKey="Text"/>
		<NormalFont style="GameFontNormal"/>
		<HighlightFont style="GameFontHighlight"/>
		<DisabledFont style="GameFontDisable"/>
		<HighlightTexture inherits="CommunityDKPButtonHighlightTexture"/>
	</Button>
	<Button name="CommunityDKPButtonTemplate" inherits="CommunityDKPUIPanelButtonNoTooltipTemplate" virtual="true">
		<Size>
